# ===========================================================================
# 5. Handler contract and handler sections
#
# Every harness specific decision lives here. The core knows the contract
# and the registry order, never a harness name.
#
#   h_<key>_meta                     description|binary|prompt_delivery|
#                                    resume_support|duplicate_support|
#                                    duplicate_tested|trust_answer
#   h_<key>_resume_hint              text or nothing
#   h_<key>_duplicate_refusal_hint   text or nothing
#   h_<key>_resume_failure_hint      text or nothing
#   h_<key>_detect                   installed|path|version
#   h_<key>_list_models              one key|description|catalog_updated per line
#   h_<key>_launch_argv F R          argv, NUL separated
#   h_<key>_model_argv M             argv, NUL separated
#   h_<key>_prompt_prefix_argv       argv, NUL separated
#   h_<key>_detect_prompt_type       pane text on stdin, prints one token
#   h_<key>_session_store_exists P   exit status 0 means it exists
#   h_<key>_duplicate_session S D    status|files|bytes|session_dir
#
# Handlers never emit and never write to stdout other than their return
# value.
# ===========================================================================

emit_detect_line() {
  printf '%s|%s|%s\n' "$DET_INSTALLED" "$DET_PATH" "$DET_VERSION"
}

# A line that is exactly the prompt glyph once whitespace is removed is
# the ready marker of two harnesses. It also stands while they work, so
# the busy markers win.
has_ready_glyph() {
  local text=$1 line
  while IFS= read -r line; do
    trim4 "$line"
    [[ $TRIMMED == "❯" ]] && return 0
  done <<<"$text"
  return 1
}

