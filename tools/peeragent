# ===========================================================================
# 6. Tmux runtime
# ===========================================================================

# Session commands address "=<name>", window and pane commands
# "=<name>:". Without the colon tmux reads the argument as a window name
# and the call fails.
tmux_run() {
  run "$TIMEOUT_TMUX" tmux -u "$@"
}

session_slug() {
  local folder=$1 base
  base=${folder%/}
  base=${base##*/}
  [[ -n $base ]] || base="workdir"
  base=${base//[^A-Za-z0-9]/-}
  base=${base:0:SESSION_SLUG_MAX}
  [[ -n $base ]] || base="workdir"
  SLUG=$base
}

# The session is created with the default shell, gets remain-on-exit, and
# only then is the harness started into the pane with respawn-pane -k. A
# harness that dies at once therefore leaves its output and its exit
# status behind instead of taking the pane with it.
create_session() {
  local folder=$1 key=$2
  shift 2
  local -a argv=("$@")
  local attempt sess created=0
  session_slug "$folder"
  local slug=$SLUG
  for ((attempt = 1; attempt <= SESSION_ATTEMPTS; attempt++)); do
    rand_hex8
    sess="peeragent-$slug-$key-$HEX8"
    tmux_run new-session -d -s "$sess" -c "$folder" -x "$PANE_WIDTH" -y "$PANE_HEIGHT"
    if ((RUN_RC == 0)); then
      created=1
      break
    fi
    if [[ $RUN_ERR == *"duplicate session"* ]]; then
      continue
    fi
    fatal 1 "could not create the tmux session" \
      "tmux refused to create the session: ${RUN_ERR:-no error output}; check that the tmux server is reachable"
  done
  if ((created == 0)); then
    fatal 1 "could not find a free session name after $SESSION_ATTEMPTS attempts" \
      "an unusual number of peeragent sessions is running; list them with 'tmux ls' and remove the ones you no longer need"
  fi
  SESSION=$sess

  # set-option resolves its target as a pane, so the window part has to be
  # present even for a session option; an exact session name on its own is
  # rejected by tmux.
  tmux_run set-option -t "=$sess:" mouse on
  if ((RUN_RC != 0)); then session_setup_failed "set-option mouse"; fi
  tmux_run set-option -t "=$sess:" -w remain-on-exit on
  if ((RUN_RC != 0)); then session_setup_failed "set-option remain-on-exit"; fi
  tmux_run respawn-pane -k -t "=$sess:" -c "$folder" "${argv[@]}"
  if ((RUN_RC != 0)); then session_setup_failed "respawn-pane"; fi
  return 0
}
SESSION=""

# Removing the session is only safe while no harness runs in it, which is
# exactly the window between new-session and respawn-pane.
session_setup_failed() {
  local what=$1 err=$RUN_ERR
  tmux_run kill-session -t "=$SESSION"
  fatal 1 "could not prepare the tmux session ($what)" \
    "tmux reported: ${err:-no error output}; the session was removed again, no harness was started"
}

pane_state() {
  local sess=$1 line
  PANE_DEAD=0
  PANE_STATUS=""
  PANE_PID=""
  tmux_run list-panes -t "=$sess" -F '#{pane_dead},#{pane_dead_status},#{pane_pid}'
  ((RUN_RC == 0)) || return 1
  line=${RUN_OUT%%$'\n'*}
  PANE_DEAD=${line%%,*}
  line=${line#*,}
  PANE_STATUS=${line%%,*}
  PANE_PID=${line#*,}
  [[ $PANE_DEAD == 1 ]] || PANE_DEAD=0
  return 0
}

# Visible pane content at the fixed size. A dead pane only shows the
# tmux placeholder in the visible area, so the scrollback is read too and
# cut to the last non-empty lines.
capture_pane() {
  local sess=$1 dead=$2 l
  CAP_LINES=()
  local -a raw=()
  if [[ $dead == 1 ]]; then
    tmux_run capture-pane -t "=$sess:" -p -S -
  else
    tmux_run capture-pane -t "=$sess:" -p
  fi
  ((RUN_RC == 0)) || return 1
  mapfile -t raw <"$RUN_OUT_FILE"
  local -a out=()
  for l in ${raw[@]+"${raw[@]}"}; do
    utf8_clean "$l"
    trim_right "$UC"
    out+=("$TRIMMED")
  done
  local i n
  if [[ $dead == 1 ]]; then
    local -a keep=()
    for l in ${out[@]+"${out[@]}"}; do
      [[ -n $l ]] && keep+=("$l")
    done
    n=${#keep[@]}
    local start=0
    ((n > DEAD_PANE_LINES)) && start=$((n - DEAD_PANE_LINES))
    for ((i = start; i < n; i++)); do CAP_LINES+=("${keep[i]}"); done
  else
    n=${#out[@]}
    while ((n > 0)) && [[ -z ${out[n-1]} ]]; do ((n--)); done
    for ((i = 0; i < n; i++)); do CAP_LINES+=("${out[i]}"); done
  fi
  join_lines
  return 0
}

classify_pane() {
  local key=$1
  if [[ -z $key ]]; then
    AWAITING="unknown"
    return 0
  fi
  AWAITING=$(printf '%s' "$CAP_TEXT" | "h_${key}_detect_prompt_type")
  trim4 "$AWAITING"
  AWAITING=$TRIMMED
  [[ -n $AWAITING ]] || AWAITING="unknown"
  return 0
}
AWAITING=""

# Direct children of the pane process and their children. comm is cut to
# fifteen characters by the kernel and does not identify a harness; args
# is the column to read.
collect_children() {
  local root=$1 p line rest cpid comm args depth pid
  EMIT_CHILDREN=()
  p=$(type -P ps 2>/dev/null) || p=""
  if [[ -z $p ]]; then
    emit warn msg=s:"ps is not available, the process list stays empty" \
      user_relevant=b:true \
      hint=s:"install the 'procps' package to see the processes of the launched harness"
    return 0
  fi
  local -a level=("$root") next=()
  for depth in 1 2; do
    next=()
    for pid in ${level[@]+"${level[@]}"}; do
      run "$TIMEOUT_PS" ps -o pid=,comm=,args= --ppid "$pid"
      ((RUN_RC == 0)) || continue
      while IFS= read -r line; do
        trim4 "$line"
        line=$TRIMMED
        [[ -n $line ]] || continue
        cpid=${line%%[$RWS]*}
        rest=${line#"$cpid"}
        trim4 "$rest"
        rest=$TRIMMED
        comm=${rest%%[$RWS]*}
        args=${rest#"$comm"}
        trim4 "$args"
        args=$TRIMMED
        [[ $cpid == +([0-9]) ]] || continue
        EMIT_CHILDREN+=("$cpid|$comm|$args")
        next+=("$cpid")
      done <<<"$RUN_OUT"
    done
    level=(${next[@]+"${next[@]}"})
    ((${#level[@]})) || break
  done
  return 0
}

# The prompt text is always the last argv element. One generic wrapper
# reads the file and execs the harness, so the prompt passes through no
# shell level and needs no quoting.
build_launch_argv() {
  local key=$1 folder=$2 resume=$3 model=$4 prompt_file=$5
  local -a launch=() marg=() prefix=()
  mapfile -d '' -t launch < <("h_${key}_launch_argv" "$folder" "$resume")
  if [[ -n $model ]]; then
    mapfile -d '' -t marg < <("h_${key}_model_argv" "$model")
  fi
  if [[ $H_PROMPT_DELIVERY == argv && -n $prompt_file ]]; then
    mapfile -d '' -t prefix < <("h_${key}_prompt_prefix_argv")
    # Command substitution drops trailing line feeds by itself; the loop
    # takes carriage returns off as well, so a CRLF file does not put a
    # stray CR on the harness command line.
    LAUNCH_ARGV=(bash -c 'pf=$1; shift; p=$(cat "$pf")
      while [ "${p%$'"'"'\r'"'"'}" != "$p" ] || [ "${p%$'"'"'\n'"'"'}" != "$p" ]; do
        p=${p%$'"'"'\r'"'"'}; p=${p%$'"'"'\n'"'"'}
      done
      exec "$@" "$p"' _ "$prompt_file"
      ${launch[@]+"${launch[@]}"} ${marg[@]+"${marg[@]}"} ${prefix[@]+"${prefix[@]}"})
  else
    LAUNCH_ARGV=(${launch[@]+"${launch[@]}"} ${marg[@]+"${marg[@]}"})
  fi
  return 0
}
declare -a LAUNCH_ARGV=()

# Bracketed paste keeps tmux from turning line feeds into carriage
# returns and sending every line on its own. Trailing line breaks are
# removed from the copy and Enter is always sent afterwards.
paste_prompt() {
  local sess=$1 pf=$2 content copy
  ensure_tmpd || return 1
  copy="$TMPD/prompt.txt"
  content=$(<"$pf")
  # Command substitution strips trailing line feeds, not carriage
  # returns. A CRLF file would otherwise send a literal CR into the
  # harness under bracketed paste.
  while [[ $content == *$'\r' || $content == *$'\n' ]]; do
    content=${content%$'\r'}
    content=${content%$'\n'}
  done
  printf '%s' "$content" >"$copy" || return 1
  PASTE_BUFFER="peeragent-$$"
  tmux_run load-buffer -b "$PASTE_BUFFER" "$copy"
  if ((RUN_RC != 0)); then
    PASTE_ERR=$RUN_ERR
    tmux_run delete-buffer -b "$PASTE_BUFFER"
    PASTE_BUFFER=""
    return 1
  fi
  tmux_run paste-buffer -p -t "=$sess:" -b "$PASTE_BUFFER"
  if ((RUN_RC != 0)); then
    PASTE_ERR=$RUN_ERR
    tmux_run delete-buffer -b "$PASTE_BUFFER"
    PASTE_BUFFER=""
    return 1
  fi
  tmux_run send-keys -t "=$sess:" Enter
  tmux_run delete-buffer -b "$PASTE_BUFFER"
  PASTE_BUFFER=""
  return 0
}
PASTE_ERR=""

# ===========================================================================
# 7. Git setup
# ===========================================================================

git_init_folder() {
  local folder=$1 nested=0 top
  run_git "$TIMEOUT_GIT" git -C "$folder" rev-parse --show-toplevel
  if ((RUN_RC == 0)); then
    trim4 "${RUN_OUT%%$'\n'*}"
    top=$TRIMMED
    if [[ -n $top && $top != "$folder" ]]; then nested=1; fi
  fi
  run_git "$TIMEOUT_GIT_INIT" git -C "$folder" init -b main
  if ((RUN_RC != 0)); then
    fatal 1 "git init failed in $folder" \
      "git reported: ${RUN_ERR:-no error output}; fix the repository state and start again, no harness was started"
  fi
  if ((nested)); then
    emit warn msg=s:"the new repository lies inside another repository" \
      user_relevant=b:true \
      hint=s:"the working directory is below an existing repository at $top; commits there may end up in the wrong history"
  fi
  return 0
}

# ===========================================================================
# 8. Preflight
# ===========================================================================

pf_tmux() {
  local p v
  p=$(type -P tmux 2>/dev/null) || p=""
  if [[ -z $p ]]; then
    fatal 3 "tmux is not installed" \
      "peeragent runs every harness inside a tmux session and needs tmux 3.2 or newer; install the 'tmux' package of your distribution, see docs/harnesses.md"
  fi
  run "$TIMEOUT_TMUX" tmux -V
  # A binary that is there but cannot answer is not a usable tmux: the
  # runtime depends on it, so this refuses rather than carrying an
  # unknown version forward.
  if ((RUN_RC != 0)); then
    fatal 3 "tmux is installed but did not answer a version query" \
      "run 'tmux -V' by hand; a tmux that cannot report its version will not carry a session either"
  fi
  trim4 "${RUN_OUT#tmux }"
  v=$TRIMMED
  [[ -n $v ]] || v="unknown"
  TMUX_VERSION=$v
  emit info msg=s:"tmux found: $v"
  return 0
}

pf_git() {
  local p v
  p=$(type -P git 2>/dev/null) || p=""
  if [[ -z $p ]]; then
    fatal 3 "git is not installed" \
      "--git-repo runs 'git init -b main' in the working directory and needs git; install the 'git' package of your distribution, see docs/harnesses.md"
  fi
  run_git "$TIMEOUT_GIT" git --version
  if ((RUN_RC != 0)); then
    fatal 3 "git is installed but did not answer a version query" \
      "run 'git --version' by hand; this call is only made when --git-repo was asked for"
  fi
  trim4 "${RUN_OUT#git version }"
  v=$TRIMMED
  [[ -n $v ]] || v="unknown"
  GIT_VERSION=$v
  emit info msg=s:"git found: $v"
  return 0
}

pf_harness_known() {
  if ! handler_known "$1"; then
    fatal 2 "unknown harness key: $1" \
      "known keys are claude, codex, agy, opencode and copilot; run 'peeragent list harness' to see which of them are installed"
  fi
  load_handler "$1"
  return 0
}

detect_current_handler() {
  local out
  DET_RC=0
  if [[ -n $TMPD ]]; then rm -f -- "$TMPD/detect.rc"; fi
  out=$("h_${H_KEY}_detect")
  IFS='|' read -r DET_INSTALLED DET_PATH DET_VERSION <<<"${out%%$'\n'*}"
  DET_INSTALLED=${DET_INSTALLED:-0}
  if [[ -n $TMPD && -r "$TMPD/detect.rc" ]]; then
    DET_RC=$(<"$TMPD/detect.rc")
    DET_RC=${DET_RC:-0}
  fi
  return 0
}

emit_harness_found() {
  if [[ -n $DET_VERSION ]]; then
    emit info msg=s:"harness $H_KEY found: $DET_VERSION"
  else
    emit info msg=s:"harness $H_KEY found, version unknown"
    emit_version_warn
  fi
  return 0
}

emit_version_warn() {
  if ((DET_RC == 124)); then
    emit warn msg=s:"$H_BINARY --version timed out after ${TIMEOUT_DETECT}s" \
      user_relevant=b:true \
      hint=s:"the $H_KEY wrapper may be installing an update; retry or run '$H_BINARY --version' manually"
  else
    emit warn msg=s:"$H_BINARY --version did not report a version" \
      user_relevant=b:true \
      hint=s:"run '$H_BINARY --version' manually to see why it fails; peeragent does not evaluate the version and continues"
  fi
  return 0
}

pf_harness_installed() {
  detect_current_handler
  if ((DET_INSTALLED == 0)); then
    fatal 3 "harness $H_KEY is not installed" \
      "the binary '$H_BINARY' was not found in PATH; install the harness or pick another key, see docs/harnesses.md"
  fi
  emit_harness_found
  return 0
}

pf_prompt_file() {
  local pf=$1 size content
  if [[ ! -e $pf ]]; then
    fatal 2 "prompt file does not exist: $pf" \
      "pass an existing file with --prompt-file, or start without a prompt and deliver it later with 'peeragent send'"
  fi
  if [[ ! -f $pf ]]; then
    fatal 2 "prompt file is not a regular file: $pf" \
      "--prompt-file expects a regular file holding the launch prompt"
  fi
  if [[ ! -r $pf ]]; then
    fatal 2 "prompt file is not readable: $pf" \
      "adjust the permissions of the file so that peeragent can read it"
  fi
  size=$(stat -c %s -- "$pf" 2>/dev/null) || size=0
  if ((size == 0)); then
    fatal 2 "prompt file is empty: $pf" \
      "write the prompt into the file, or start without --prompt-file to leave the harness waiting"
  fi
  content=$(<"$pf")
  prompt_effective_length "$content"
  if ((PEFF_LEN > PROMPT_LIMIT)); then
    fatal 2 "prompt holds $PEFF_LEN effective characters, the limit is $PROMPT_LIMIT" \
      "write the assignment into a file in the working directory and pass a short prompt that points at it, with the scope and the stopping condition; paths that start with / and contain no spaces do not count towards the limit"
  fi
  PROMPT_BYTES=$size
  return 0
}

# ===========================================================================
# 9. Commands
# ===========================================================================

cmd_version() {
  emit version version=s:"$PEERAGENT_VERSION" impl=s:"$PEERAGENT_IMPL"
  return 0
}

cmd_list_harness() {
  local key out
  for key in $HANDLER_KEYS; do
    load_handler "$key"
    detect_current_handler
    if ((DET_INSTALLED)); then
      if [[ -n $DET_VERSION ]]; then
        emit harness.detected key=s:"$key" version=s:"$DET_VERSION" \
          description=s:"$H_DESCRIPTION" path=s:"$DET_PATH"
      else
        emit harness.detected key=s:"$key" version=z: \
          description=s:"$H_DESCRIPTION" path=s:"$DET_PATH"
        emit_version_warn
      fi
    else
      emit harness.missing key=s:"$key" description=s:"$H_DESCRIPTION"
    fi
  done
  return 0
}

emit_models_of() {
  local key=$1 line k d
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    k=${line%%|*}
    d=${line#*|}
    emit model.available harness=s:"$key" key=s:"$k" description=s:"$d" \
      catalog_updated=s:"$CATALOG_UPDATED"
  done < <("h_${key}_list_models")
  return 0
}

cmd_list_models() {
  local key
  if [[ -n $ARG_HARNESS ]]; then
    pf_harness_known "$ARG_HARNESS"
    pf_harness_installed
    emit_models_of "$ARG_HARNESS"
    return 0
  fi
  local -a installed=()
  for key in $HANDLER_KEYS; do
    load_handler "$key"
    detect_current_handler
    ((DET_INSTALLED)) || continue
    installed+=("$key")
    emit_harness_found
  done
  for key in ${installed[@]+"${installed[@]}"}; do
    emit_models_of "$key"
  done
  return 0
}

cmd_list_git_templates() {
  fatal 2 "the subcommand 'list git-templates' does not exist in this version" \
    "git templates are planned for a later release; use --git-repo on 'start agent' to run 'git init -b main' in the working directory, see docs/cli.md"
}

# One place where the deferred prompt hint is built, so that both delivery
# paths keep the same wording.
deferred_hint() {
  local delivery=$1 sess=$2 pf=$3
  if [[ $delivery == send_keys ]]; then
    DEFERRED_HINT="deliver with: peeragent send --session $sess --prompt-file $pf"
  else
    DEFERRED_HINT="the prompt was passed as a command-line argument; once the pane has reached a state you understand, capture it - if the harness did not pick the prompt up, deliver with: peeragent send --session $sess --prompt-file $pf"
  fi
}
DEFERRED_HINT=""

append_resume_failure_hint() {
  local base=$1
  RESUME_HINTED=$base
  ((ARG_RESUME)) || return 0
  handler_hint "$H_KEY" resume_failure_hint
  [[ -n $HINT_TEXT ]] || return 0
  RESUME_HINTED="$base; $HINT_TEXT"
  return 0
}
RESUME_HINTED=""

cmd_start_agent() {
  local t_start t_step sess awaiting first_text second_text
  now_ms
  t_start=$NOW_MS

  pf_tmux
  pf_harness_known "$ARG_HARNESS"
  pf_harness_installed
  if [[ ! -d $ARG_FOLDER ]]; then
    fatal 2 "folder does not exist or is not a directory: $ARG_FOLDER" \
      "pass an existing working directory with --folder"
  fi
  if ((ARG_GIT_REPO)) && [[ -e "$ARG_FOLDER/.git" ]]; then
    fatal 2 "folder is already a git repo" \
      "drop --git-repo; the working directory already holds a repository, and peeragent never initialises over one"
  fi
  if ((ARG_GIT_REPO)); then pf_git; fi
  if ((ARG_RESUME)) && [[ $H_RESUME_SUPPORT == unsupported ]]; then
    fatal 2 "harness $H_KEY cannot resume a session" \
      "start without --resume; this harness has no resume path that peeragent can use"
  fi
  if [[ -n $ARG_PROMPT_FILE ]]; then pf_prompt_file "$ARG_PROMPT_FILE"; fi
  timing preflight "$t_start"

  if ((ARG_GIT_REPO)); then
    now_ms
    t_step=$NOW_MS
    git_init_folder "$ARG_FOLDER"
    timing git-init "$t_step"
  fi

  build_launch_argv "$H_KEY" "$ARG_FOLDER" "$ARG_RESUME" "$ARG_MODEL" "$ARG_PROMPT_FILE"

  local -a f=(agent.starting harness=s:"$H_KEY" folder=s:"$ARG_FOLDER")
  if [[ -n $ARG_MODEL ]]; then f+=(model=s:"$ARG_MODEL"); else f+=(model=z:); fi
  if ((ARG_RESUME)); then f+=(resume=b:true); else f+=(resume=b:false); fi
  if [[ -n $ARG_PROMPT_FILE ]]; then
    f+=(prompt_file=s:"$ARG_PROMPT_FILE")
  else
    f+=(prompt_file=z:)
  fi
  emit "${f[@]}"

  if ((ARG_RESUME)) && [[ $H_RESUME_SUPPORT == experimental ]]; then
    handler_hint "$H_KEY" resume_hint
    if [[ -n $HINT_TEXT ]]; then
      emit warn msg=s:"resume support of harness $H_KEY is experimental" \
        user_relevant=b:true hint=s:"$HINT_TEXT"
    else
      emit warn msg=s:"resume support of harness $H_KEY is experimental" \
        user_relevant=b:true
    fi
  fi

  if [[ -n ${TMUX-} ]]; then
    emit debug msg=s:"peeragent itself runs inside a tmux session"
  fi

  now_ms
  t_step=$NOW_MS
  create_session "$ARG_FOLDER" "$H_KEY" "${LAUNCH_ARGV[@]}"
  sess=$SESSION
  timing tmux-create "$t_step"

  now_ms
  t_step=$NOW_MS
  sleep "$ARG_BOOT_WAIT"
  timing boot-wait "$t_step"

  now_ms
  t_step=$NOW_MS
  if ! pane_state "$sess"; then
    fatal 1 "could not read the state of the pane in $sess" \
      "tmux reported: ${RUN_ERR:-no error output}; look at the session yourself: tmux attach -r -t '=$sess'"
  fi
  local pane_pid=$PANE_PID dead=$PANE_DEAD status=$PANE_STATUS
  capture_pane "$sess" "$dead"

  if [[ $dead == 1 ]]; then
    EMIT_LINES=(${CAP_LINES[@]+"${CAP_LINES[@]}"})
    append_resume_failure_hint "the harness exited during startup; the tmux session was kept: tmux attach -r -t '=$sess'"
    local -a ef=(agent.exited session=s:"$sess")
    if [[ $status == +([0-9]) ]]; then
      ef+=(exit_status=n:"$status")
    else
      ef+=(exit_status=z:)
    fi
    ef+=(lines=a: hint=s:"$RESUME_HINTED" user_relevant=b:true)
    emit "${ef[@]}"
    timing diagnose "$t_step"
    exit 4
  fi

  classify_pane "$H_KEY"
  awaiting=$AWAITING
  first_text=$CAP_TEXT
  case $awaiting in
    trust_prompt | auth_prompt | provider_prompt) ;;
    *)
      sleep "$SECOND_CAPTURE_WAIT"
      if capture_pane "$sess" 0; then
        second_text=$CAP_TEXT
        if [[ $second_text != "$first_text" ]]; then awaiting="busy"; fi
      fi
      ;;
  esac
  EMIT_LINES=(${CAP_LINES[@]+"${CAP_LINES[@]}"})
  emit agent.pane session=s:"$sess" awaiting=s:"$awaiting" lines=a:
  timing diagnose "$t_step"

  case $awaiting in
    trust_prompt)
      if [[ -n $H_TRUST_ANSWER ]]; then
        emit warn msg=s:"harness $H_KEY is awaiting trust-prompt confirmation" \
          user_relevant=b:true \
          hint=s:"send '$H_TRUST_ANSWER' to trust: tmux send-keys -t '=$sess:' $H_TRUST_ANSWER"
      else
        emit warn msg=s:"harness $H_KEY is awaiting trust-prompt confirmation" \
          user_relevant=b:true \
          hint=s:"answer the question in the pane yourself: tmux attach -r -t '=$sess'"
      fi
      ;;
    auth_prompt)
      emit warn msg=s:"harness $H_KEY is not signed in" user_relevant=b:true \
        hint=s:"the harness needs a login that peeragent cannot perform; sign in outside peeragent and start again, or look at the pane: tmux attach -r -t '=$sess'"
      ;;
    provider_prompt)
      emit warn msg=s:"harness $H_KEY needs a provider configuration" \
        user_relevant=b:true \
        hint=s:"configure a model provider in the harness, then start again, or look at the pane: tmux attach -r -t '=$sess'"
      ;;
    unknown)
      append_resume_failure_hint "unrecognised screen; show the captured lines to the user and ask how to proceed"
      emit warn msg=s:"harness $H_KEY shows a screen peeragent does not recognise" \
        user_relevant=b:true hint=s:"$RESUME_HINTED"
      ;;
  esac

  local delivered=0
  if [[ -n $ARG_PROMPT_FILE ]]; then
    if [[ $H_PROMPT_DELIVERY == argv ]]; then
      case $awaiting in
        busy | ready) delivered=1 ;;
      esac
    elif [[ $awaiting == ready ]]; then
      now_ms
      t_step=$NOW_MS
      if paste_prompt "$sess" "$ARG_PROMPT_FILE"; then
        timing paste "$t_step"
        emit agent.prompt_sent session=s:"$sess" bytes=n:"$PROMPT_BYTES"
        delivered=1
        now_ms
        t_step=$NOW_MS
        sleep "$POST_PASTE_WAIT"
        if pane_state "$sess" && capture_pane "$sess" "$PANE_DEAD"; then
          classify_pane "$H_KEY"
          EMIT_LINES=(${CAP_LINES[@]+"${CAP_LINES[@]}"})
          emit agent.pane session=s:"$sess" awaiting=s:"$AWAITING" lines=a:
        fi
        timing paste-wait "$t_step"
      else
        emit error msg=s:"could not paste the prompt into $sess" \
          user_relevant=b:true \
          hint=s:"tmux reported: ${PASTE_ERR:-no error output}; deliver it again with: peeragent send --session $sess --prompt-file $ARG_PROMPT_FILE"
        # The error already says what happened and how to repeat it. A
        # deferred message on top would report the same thing a second
        # time with a different name, and the deferred message belongs to
        # a pane that was not ready - this one was.
        delivered=1
      fi
    fi
    if ((delivered == 0)); then
      deferred_hint "$H_PROMPT_DELIVERY" "$sess" "$ARG_PROMPT_FILE"
      emit agent.prompt_deferred session=s:"$sess" \
        prompt_file=s:"$ARG_PROMPT_FILE" awaiting=s:"$awaiting" \
        delivery=s:"$H_PROMPT_DELIVERY" hint=s:"$DEFERRED_HINT" \
        user_relevant=b:true
    fi
  fi

  now_ms
  t_step=$NOW_MS
  collect_children "$pane_pid"
  timing process-tree "$t_step"
  emit agent.started session=s:"$sess" pane_pid=n:"$pane_pid" \
    child_processes=p: hint=s:"watch with: tmux attach -r -t '=$sess'"
  return 0
}

handler_from_session() {
  SESSION_HANDLER=""
  if [[ $1 =~ ^peeragent-(.+)-(claude|codex|agy|opencode|copilot)-([0-9a-f]{8})$ ]]; then
    SESSION_HANDLER=${BASH_REMATCH[2]}
  fi
  return 0
}
SESSION_HANDLER=""

cmd_send() {
  local t_start t_step sess=$ARG_SESSION
  now_ms
  t_start=$NOW_MS

  pf_tmux
  tmux_run has-session -t "=$sess"
  if ((RUN_RC != 0)); then
    fatal 2 "no tmux session named $sess" \
      "pass the session name that 'start agent' reported; list the running sessions with 'tmux ls'"
  fi
  handler_from_session "$sess"
  if [[ -n $SESSION_HANDLER ]]; then
    load_handler "$SESSION_HANDLER"
    detect_current_handler
    if ((DET_INSTALLED)); then
      emit_harness_found
    else
      emit warn msg=s:"harness $H_KEY is not installed on this host" \
        user_relevant=b:true \
        hint=s:"the prompt is pasted into the running session anyway; peeragent does not need the binary for that"
    fi
  else
    H_KEY=""
  fi
  pf_prompt_file "$ARG_PROMPT_FILE"
  if ! pane_state "$sess"; then
    fatal 1 "could not read the state of the pane in $sess" \
      "tmux reported: ${RUN_ERR:-no error output}; look at the session yourself: tmux attach -r -t '=$sess'"
  fi
  if [[ $PANE_DEAD == 1 ]]; then
    fatal 2 "the harness in $sess is no longer running" \
      "the pane is dead, a paste would go nowhere; look at it with 'tmux attach -r -t \"=$sess\"' and start a new session"
  fi
  timing preflight "$t_start"

  capture_pane "$sess" 0
  classify_pane "$H_KEY"
  EMIT_LINES=(${CAP_LINES[@]+"${CAP_LINES[@]}"})
  emit agent.pane session=s:"$sess" awaiting=s:"$AWAITING" lines=a:

  now_ms
  t_step=$NOW_MS
  if ! paste_prompt "$sess" "$ARG_PROMPT_FILE"; then
    fatal 1 "could not paste the prompt into $sess" \
      "tmux reported: ${PASTE_ERR:-no error output}; check that the session still holds a live pane and try again"
  fi
  timing paste "$t_step"
  emit agent.prompt_sent session=s:"$sess" bytes=n:"$PROMPT_BYTES"

  now_ms
  t_step=$NOW_MS
  sleep "$ARG_WAIT"
  if pane_state "$sess" && capture_pane "$sess" "$PANE_DEAD"; then
    classify_pane "$H_KEY"
    EMIT_LINES=(${CAP_LINES[@]+"${CAP_LINES[@]}"})
    emit agent.pane session=s:"$sess" awaiting=s:"$AWAITING" lines=a:
  fi
  timing paste-wait "$t_step"
  return 0
}

cmd_duplicate() {
  local t_start t_step src=$ARG_FROM dst=$ARG_TO parent meas files bytes
  now_ms
  t_start=$NOW_MS

  pf_harness_known "$ARG_HARNESS"
  if [[ $H_DUPLICATE_SUPPORT == unsupported ]]; then
    handler_hint "$H_KEY" duplicate_refusal_hint
    fatal 2 "duplicate for $H_KEY is not supported in v1" "$HINT_TEXT"
  fi
  if [[ ! -d $src ]]; then
    fatal 2 "source does not exist or is not a directory: $src" \
      "pass an existing working directory with --from"
  fi
  parent=${dst%/*}
  [[ -n $parent ]] || parent="/"
  if [[ ! -d $parent ]]; then
    fatal 2 "parent directory of the destination does not exist: $parent" \
      "create the parent directory first, or pass a destination inside an existing one"
  fi
  if [[ $dst == "$src"/* || $src == "$dst"/* || $dst == "$src" ]]; then
    fatal 2 "source and destination overlap" \
      "pick a destination outside the source directory; copying a tree into itself would never end"
  fi
  pf_harness_installed
  if "h_${H_KEY}_session_store_exists" "$dst"; then
    fatal 1 "session store for destination already exists" \
      "the harness already has a session store for $dst; remove it or pick another destination, otherwise the copy would compete with it"
  fi
  if [[ -e $dst ]]; then
    if [[ ! -d $dst ]]; then
      fatal 1 "destination exists and differs from source" \
        "$dst exists and is not a directory; remove it or pick another destination"
    fi
    if [[ "$(list_top "$src")" != "$(list_top "$dst")" ]]; then
      fatal 1 "destination exists and differs from source" \
        "$dst already exists with other top level entries than $src; remove it or pick another destination"
    fi
  fi
  timing preflight "$t_start"

  if [[ $H_DUPLICATE_SUPPORT == experimental ]]; then
    emit warn msg=s:"duplicate support of harness $H_KEY is experimental" \
      user_relevant=b:true \
      hint=s:"check in the copy whether the harness finds the session before you rely on the history"
  fi

  now_ms
  t_step=$NOW_MS
  if [[ -e $dst ]]; then
    emit info msg=s:"workspace already present, skipped copy"
  else
    if ! mkdir -p -- "$dst" 2>/dev/null; then
      fatal 1 "could not create the destination directory: $dst" \
        "check the permissions of the parent directory"
    fi
    if ! cp -a -- "$src/." "$dst/" 2>/dev/null; then
      fatal 1 "could not copy the workspace to $dst" \
        "check the permissions and the free space of the destination; the copy is incomplete"
    fi
    meas=$(tree_measure "$dst")
    files=${meas%%|*}
    bytes=${meas#*|}
    emit info msg=s:"copied workspace" files=n:"$files" bytes=n:"$bytes"
  fi
  timing workspace-copy "$t_step"

  now_ms
  t_step=$NOW_MS
  if ! "h_${H_KEY}_session_store_exists" "$src"; then
    emit warn msg=s:"no session store found for source" user_relevant=b:true \
      hint=s:"the copy holds the working tree only; the harness will start a fresh session in it"
  fi
  local out status sfiles sbytes sdir
  out=$("h_${H_KEY}_duplicate_session" "$src" "$dst") || {
    fatal 1 "could not copy the session store of harness $H_KEY" \
      "check the permissions of the harness configuration directory; the working tree was copied, the session history was not"
  }
  IFS='|' read -r status sfiles sbytes sdir <<<"${out%%$'\n'*}"
  local -a df=(harness.duplicated key=s:"$H_KEY" status=s:"$status"
    files=n:"$sfiles" bytes=n:"$sbytes")
  if [[ -n $sdir ]]; then df+=(session_dir=s:"$sdir"); else df+=(session_dir=z:); fi
  emit "${df[@]}"
  timing session-copy "$t_step"

  emit info msg=s:"duplicate complete" \
    hint=s:"working tree shares origin and branch with source; the first start in the copy may show a trust prompt"
  return 0
}

# ===========================================================================
# 10. CLI
# ===========================================================================

usage() {
  cat <<EOF
peeragent $PEERAGENT_VERSION - start a coding agent harness in a tmux session

Usage:
  peeragent version
  peeragent list harness
  peeragent list models [--harness <key>]
  peeragent start agent --folder <path> --harness <key>
                        [--prompt-file <path>] [--model <string>]
                        [--resume] [--git-repo] [--boot-wait <seconds>]
  peeragent send --session <name> --prompt-file <path> [--wait <seconds>]
  peeragent duplicate --from <src> --to <dst> --harness <key>

Global flags:
  --json                one JSON object per message inside a JSON array
  --no-log              do not write a log file
  --log-file <path>     write the log to this path instead of the default
  --verbose             also print debug and timing messages
  --no-color            never use ANSI colors
  --help, -h            show this text and exit

Harness keys: claude, codex, agy, opencode, copilot

The launch prompt is limited to $PROMPT_LIMIT effective characters: write the
assignment into a file in the working directory and point the prompt at it.

Full reference: docs/cli.md
EOF
}

declare -a INVOCATION_ARGS=()

need_value() {
  if [[ -z ${2+x} ]]; then
    fatal 2 "flag $1 needs a value" \
      "pass a value after $1, for example '$1 <value>'; run peeragent --help for the syntax"
  fi
  return 0
}

check_int_range() {
  local flag=$1 v=$2 lo=$3 hi=$4
  if [[ ! $v =~ ^[0-9]+$ ]] || ((10#$v < lo || 10#$v > hi)); then
    fatal 2 "flag $flag expects a whole number between $lo and $hi, got: $v" \
      "pass a value in that range, for example '$flag $lo'"
  fi
  return 0
}

declare -A SEEN_FLAG=()

parse_args() {
  local -a positional=()
  local a
  while (($#)); do
    a=$1
    case $a in
      --json) ;;
      --no-log) NO_LOG=1 ;;
      --verbose) VERBOSE=1 ;;
      --no-color) NO_COLOR_FLAG=1 ;;
      --log-file)
        need_value "$a" ${2+"$2"}
        LOG_PATH_RAW=$2
        SEEN_FLAG[log-file]=1
        shift
        ;;
      --folder)
        need_value "$a" ${2+"$2"}
        ARG_FOLDER=$2
        SEEN_FLAG[folder]=1
        shift
        ;;
      --harness)
        need_value "$a" ${2+"$2"}
        ARG_HARNESS=$2
        SEEN_FLAG[harness]=1
        shift
        ;;
      --prompt-file)
        need_value "$a" ${2+"$2"}
        ARG_PROMPT_FILE=$2
        SEEN_FLAG[prompt-file]=1
        shift
        ;;
      --model)
        need_value "$a" ${2+"$2"}
        ARG_MODEL=$2
        SEEN_FLAG[model]=1
        shift
        ;;
      --session)
        need_value "$a" ${2+"$2"}
        ARG_SESSION=$2
        SEEN_FLAG[session]=1
        shift
        ;;
      --from)
        need_value "$a" ${2+"$2"}
        ARG_FROM=$2
        SEEN_FLAG[from]=1
        shift
        ;;
      --to)
        need_value "$a" ${2+"$2"}
        ARG_TO=$2
        SEEN_FLAG[to]=1
        shift
        ;;
      --resume)
        ARG_RESUME=1
        SEEN_FLAG[resume]=1
        ;;
      --git-repo)
        ARG_GIT_REPO=1
        SEEN_FLAG[git-repo]=1
        ;;
      --boot-wait)
        need_value "$a" ${2+"$2"}
        check_int_range "$a" "$2" 1 120
        ARG_BOOT_WAIT=$((10#$2))
        SEEN_FLAG[boot-wait]=1
        shift
        ;;
      --wait)
        need_value "$a" ${2+"$2"}
        check_int_range "$a" "$2" 0 120
        ARG_WAIT=$((10#$2))
        SEEN_FLAG[wait]=1
        shift
        ;;
      -*)
        fatal 2 "unknown flag: $a" \
          "run 'peeragent --help' to see the flags of each subcommand, or see docs/cli.md"
        ;;
      *) positional+=("$a") ;;
    esac
    shift
  done

  if ((NO_LOG)) && [[ -n ${SEEN_FLAG[log-file]+x} ]]; then
    # The two contradict each other, and the refusal honours the more
    # restrictive one: somebody who asked for no log does not get a file
    # written as a side effect of being told off.
    LOG_ENABLED=0
    fatal 2 "--no-log and --log-file contradict each other" \
      "pass either --no-log to write no log at all, or --log-file <path> to choose where the log goes"
  fi

  local n=${#positional[@]} sub="" second="" expected=1
  ((n > 0)) && sub=${positional[0]}
  ((n > 1)) && second=${positional[1]}
  case $sub in
    "")
      fatal 2 "no subcommand given" \
        "run 'peeragent --help' to see the available subcommands"
      ;;
    list)
      expected=2
      case $second in
        harness) CMD="list-harness" ;;
        models) CMD="list-models" ;;
        git-templates) CMD="list-git-templates" ;;
        "")
          fatal 2 "'list' needs a target" \
            "use 'peeragent list harness' or 'peeragent list models'"
          ;;
        *)
          fatal 2 "unknown list target: $second" \
            "use 'peeragent list harness' or 'peeragent list models'"
          ;;
      esac
      ;;
    start)
      expected=2
      case $second in
        agent) CMD="start-agent" ;;
        "")
          fatal 2 "'start' needs a target" \
            "use 'peeragent start agent --folder <path> --harness <key>'"
          ;;
        *)
          fatal 2 "unknown start target: $second" \
            "use 'peeragent start agent --folder <path> --harness <key>'"
          ;;
      esac
      ;;
    send) CMD="send" ;;
    duplicate) CMD="duplicate" ;;
    version) CMD="version" ;;
    *)
      fatal 2 "unknown subcommand: $sub" \
        "run 'peeragent --help' to see the available subcommands"
      ;;
  esac
  if ((n > expected)); then
    fatal 2 "unexpected argument: ${positional[expected]}" \
      "run 'peeragent --help' to see the syntax of each subcommand"
  fi

  check_flag_scope
  fill_defaults
  return 0
}
LOG_PATH_RAW=""

# Every subcommand accepts the global flags and only its own; a flag from
# another subcommand is an argument error, not a silently ignored value.
check_flag_scope() {
  local allowed flag
  case $CMD in
    version | list-harness | list-git-templates) allowed="" ;;
    list-models) allowed="harness" ;;
    start-agent) allowed="folder harness prompt-file model resume git-repo boot-wait" ;;
    send) allowed="session prompt-file wait" ;;
    duplicate) allowed="from to harness" ;;
    *) allowed="" ;;
  esac
  for flag in "${!SEEN_FLAG[@]}"; do
    [[ $flag == "log-file" ]] && continue
    if [[ " $allowed " != *" $flag "* ]]; then
      fatal 2 "flag --$flag does not belong to this subcommand" \
        "drop --$flag here; run 'peeragent --help' to see which flags each subcommand takes"
    fi
  done

  local -a required=()
  case $CMD in
    start-agent) required=(folder harness) ;;
    send) required=(session prompt-file) ;;
    duplicate) required=(from to harness) ;;
  esac
  for flag in ${required[@]+"${required[@]}"}; do
    if [[ -z ${SEEN_FLAG[$flag]+x} ]]; then
      fatal 2 "flag --$flag is required for this subcommand" \
        "pass --$flag; run 'peeragent --help' to see the syntax of each subcommand"
    fi
  done
  return 0
}

# Every path argument is made absolute before its first use; a path that
# does not exist yet is allowed, the preflight decides about existence.
fill_defaults() {
  if [[ -n $ARG_FOLDER ]]; then
    abs_path "$ARG_FOLDER"
    ARG_FOLDER=$ABS
  fi
  if [[ -n $ARG_PROMPT_FILE ]]; then
    abs_path "$ARG_PROMPT_FILE"
    ARG_PROMPT_FILE=$ABS
  fi
  if [[ -n $ARG_FROM ]]; then
    abs_path "$ARG_FROM"
    ARG_FROM=$ABS
  fi
  if [[ -n $ARG_TO ]]; then
    abs_path "$ARG_TO"
    ARG_TO=$ABS
  fi
  if [[ -n $LOG_PATH_RAW ]]; then
    abs_path "$LOG_PATH_RAW"
    LOG_PATH=$ABS
  fi
  case $CMD in
    list-harness) LOG_ACTION="list-harness" ;;
    list-models) LOG_ACTION="list-models" ;;
    start-agent) LOG_ACTION="start-agent" ;;
    send) LOG_ACTION="send" ;;
    duplicate) LOG_ACTION="duplicate" ;;
    version) LOG_ACTION="version" ;;
    *) LOG_ACTION="invalid" ;;
  esac
  return 0
}

setup_color() {
  COLOR=0
  [[ $OUT_MODE == plain ]] || return 0
  ((NO_COLOR_FLAG)) && return 0
  [[ -n ${NO_COLOR-} ]] && return 0
  [[ -t 1 ]] || return 0
  COLOR=1
  return 0
}

main() {
  local a
  init_json_ctl
  INVOCATION_ARGS=("$@")

  # --help wins over everything and prints no array, so that a caller who
  # asks for the syntax never has to parse a message stream.
  for a in "$@"; do
    if [[ $a == "--help" || $a == "-h" ]]; then
      LOG_ENABLED=0
      usage
      exit 0
    fi
  done

  for a in "$@"; do
    if [[ $a == "--json" ]]; then
      OUT_MODE="json"
      break
    fi
  done

  trap 'on_exit' EXIT
  trap 'on_signal 2' INT
  trap 'on_signal 15' TERM
  trap 'on_signal 1' HUP

  if [[ $OUT_MODE == json ]]; then
    printf '[\n'
    ARRAY_OPEN=1
  fi

  parse_args "$@"
  setup_color
  log_setup
  ensure_tmpd || true
  log_open

  case $CMD in
    version) cmd_version ;;
    list-harness) cmd_list_harness ;;
    list-models) cmd_list_models ;;
    list-git-templates) cmd_list_git_templates ;;
    start-agent) cmd_start_agent ;;
    send) cmd_send ;;
    duplicate) cmd_duplicate ;;
  esac
  exit 0
}

main "$@"
